{
  "manifest_version": 3,
  "name": "ebayカテゴリー発見君",
  "version": "1.2.0",
  "description": "eBay のカテゴリID をオフラインで検索・ツリー閲覧・コピー・検証する手動出品用ツール (EBAY_US, treeVersion 134)。eBay には一切アクセスしません。",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "clipboardWrite", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "background": {
    "service_worker": "src/service_worker.js"
  },
  "action": {
    "default_title": "ebayカテゴリー発見君 を開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
